+
+  test('sanitizes non-finite numbers on a kind the core union does not carry', () => {
+    // A plugin kind can never satisfy `AnyNodeSchema`, so the create path can be
+    // tempted to hand it straight back. That skips the numeric scrub too, and a
+    // NaN reaching a renderer's matrix silently blanks the whole InstancedMesh —
+    // no error, no clue which node did it.
+    const pluginId = 'plugin_created' as AnyNodeId
+
+    useScene.getState().createNode({
+      id: pluginId,
+      type: 'warehouse:pallet-rack',
+      parentId: null,
+      object: 'node',
+      visible: true,
+      name: 'Rack',
+      metadata: {},
+      position: [0, Number.NaN, 0],
+      bayWidth: Infinity,
+      bayCount: 4,
+    } as unknown as AnyNode)
+
+    const created = useScene.getState().nodes[pluginId] as Record<string, unknown>
+    expect(created).toBeDefined()
+    expect('bayWidth' in created).toBe(false)
+    // Fields the scrub has no business touching survive intact.
+    expect(created.bayCount).toBe(4)
+    expect(created.name).toBe('Rack')
+
+    // Documenting a real gap, not endorsing it: with no schema the walk cannot
+    // tell an array from an opaque value, so it does not descend and a NaN
+    // inside `position` survives. That is true today with or without a fast
+    // path — pinned here so a future fix is a deliberate change, not a surprise.
+    expect((created.position as unknown[])[1]).toBeNaN()
+  })
+})
+
