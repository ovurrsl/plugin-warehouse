{
  "name": "@ovurrsl/plugin-warehouse",
  "version": "0.1.0",
  "description": "Warehouse & logistics equipment plugin for the Pascal editor — pallets, racking, handling equipment, and a capacity readout.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "verify": "bun run check-types && biome ci . && bun test",
    "changelog": "git-cliff --output CHANGELOG.md && bun run scripts/update-readme.mjs"
  },
  "peerDependencies": {
    "@iconify/react": "^6",
    "@pascal-app/core": ">=0.9.2 <1",
    "@pascal-app/editor": ">=0.9.2 <1",
    "@pascal-app/viewer": ">=0.9.2 <1",
    "@react-three/fiber": "^9",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "three": "^0.185",
    "zod": "^4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@iconify/react": "^6.0.2",
    "@pascal-app/core": "^0.9.2",
    "@pascal-app/editor": "^0.9.2",
    "@pascal-app/viewer": "^0.9.2",
    "@react-three/fiber": "^9",
    "@types/bun": "^1.3.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.185.1",
    "react": "^19",
    "react-dom": "^19",
    "three": "^0.185",
    "typescript": "6.0.3",
    "zod": "^4",
    "zustand": "^5"
  },
  "keywords": [
    "pascal",
    "3d",
    "editor",
    "plugin",
    "warehouse",
    "logistics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovurrsl/plugin-warehouse.git"
  },
  "homepage": "https://editor.pascal.app/docs/developers/plugins",
  "license": "MIT"
}
